<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      CA1716: the book's Error type shares its name with a VB keyword.
      CA1711: MatchException is a domain entity, not a System.Exception.
      Both names are used throughout the book, so the rules are suppressed here.
    -->
    <NoWarn>$(NoWarn);CA1716;CA1711</NoWarn>
  </PropertyGroup>

</Project>
