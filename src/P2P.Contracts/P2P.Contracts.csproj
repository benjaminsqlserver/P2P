<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      CA1000: PagedResult<T>.Empty() and OperationResult<T>.Success/Failure are
      static factories on generic types. The book uses them throughout.
    -->
    <NoWarn>$(NoWarn);CA1000</NoWarn>
  </PropertyGroup>

</Project>
