@using P2P.Contracts.Common
@inject IVendorApi VendorApi
@inject DialogService DialogService
@inject NotificationService Notifications

<RadzenTemplateForm TItem="VendorFormModel"
                    Data="@_model"
                    Submit="@OnSubmitAsync">

    <RadzenStack Gap="1rem">

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="4">
                <RadzenFormField Text="Vendor code" Style="width: 100%;">
                    <ChildContent>
                        <RadzenTextBox Name="Code" @bind-Value="_model.Code"
                                       MaxLength="20" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="Code"
                                                 Text="A vendor code is required." />
                        <RadzenRegexValidator Component="Code"
                                              Pattern="^[A-Za-z0-9-]+$"
                                              Text="Letters, digits and hyphens only." />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="8">
                <RadzenFormField Text="Legal name" Style="width: 100%;">
                    <ChildContent>
                        <RadzenTextBox Name="LegalName" @bind-Value="_model.LegalName"
                                       MaxLength="200" />
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="LegalName"
                                                 Text="A legal name is required." />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Trading name (optional)" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="_model.TradingName" MaxLength="200" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="6">
                <RadzenFormField Text="Tax identifier (optional)" Style="width: 100%;">
                    <RadzenTextBox @bind-Value="_model.TaxIdentifier" MaxLength="50" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFieldset Text="Remit-to address">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Address line 1" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="Line1" @bind-Value="_model.Line1" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Line1"
                                                         Text="Required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Line 2" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.Line2" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="City" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="City" @bind-Value="_model.City" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="City"
                                                         Text="Required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="State / province" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.StateOrProvince" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenFormField Text="Postal code" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.PostalCode" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenFormField Text="Country" Style="width: 100%;">
                            <RadzenDropDown Name="CountryCode"
                                            @bind-Value="_model.CountryCode"
                                            Data="@_countries"
                                            TextProperty="Name"
                                            ValueProperty="Code" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Default currency" Style="width: 100%;">
                    <RadzenDropDown @bind-Value="_model.DefaultCurrency"
                                    Data="@_currencies" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Payment terms (days)" Style="width: 100%;">
                    <RadzenNumeric @bind-Value="_model.PaymentTermsDays"
                                   Min="0" Max="365" Step="1" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @if (_serverError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger"
                         Variant="Variant.Flat"
                         Shade="Shade.Lighter"
                         AllowClose="false">
                @_serverError
            </RadzenAlert>
        }

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem">
            <RadzenButton Text="Cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat"
                          ButtonType="ButtonType.Button"
                          Click="@(() => DialogService.Close(false))" />

            <RadzenButton Text="Create vendor"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_isSaving"
                          BusyText="Saving…" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly VendorFormModel _model = new();
    private bool _isSaving;
    private string? _serverError;

    private readonly string[] _currencies = ["NGN", "USD", "GBP", "EUR", "ZAR", "GHS"];

    private readonly CountryOption[] _countries =
    [
        new("NG", "Nigeria"), new("GB", "United Kingdom"),
        new("US", "United States"), new("GH", "Ghana"),
        new("ZA", "South Africa"), new("KE", "Kenya")
    ];

    private async Task OnSubmitAsync(VendorFormModel model)
    {
        _isSaving = true;
        _serverError = null;

        try
        {
            var request = new CreateVendorRequest
            {
                Code = model.Code!,
                LegalName = model.LegalName!,
                TradingName = model.TradingName,
                TaxIdentifier = model.TaxIdentifier,
                DefaultCurrency = model.DefaultCurrency,
                PaymentTermsDays = model.PaymentTermsDays,
                RemitToAddress = new AddressDto
                {
                    Line1 = model.Line1!,
                    Line2 = model.Line2,
                    City = model.City!,
                    StateOrProvince = model.StateOrProvince,
                    PostalCode = model.PostalCode!,
                    CountryCode = model.CountryCode
                }
            };

            var result = await VendorApi.CreateAsync(request);

            if (result.Succeeded)
            {
                DialogService.Close(true);
            }
            else
            {
                _serverError = result.ErrorMessage
                    ?? "The vendor could not be created.";
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed record CountryOption(string Code, string Name);

    private sealed class VendorFormModel
    {
        public string? Code { get; set; }
        public string? LegalName { get; set; }
        public string? TradingName { get; set; }
        public string? TaxIdentifier { get; set; }
        public string? Line1 { get; set; }
        public string? Line2 { get; set; }
        public string? City { get; set; }
        public string? StateOrProvince { get; set; }
        public string? PostalCode { get; set; }
        public string CountryCode { get; set; } = "NG";
        public string DefaultCurrency { get; set; } = "NGN";
        public int PaymentTermsDays { get; set; } = 30;
    }
}
