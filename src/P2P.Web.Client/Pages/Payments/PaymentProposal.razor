@page "/payments/propose"
@page "/payments"
@attribute [Authorize(Policy = Policies.CanAuthorisePayments)]
@inject IPaymentApi PaymentApi
@inject NotificationService Notifications

<PageTitle>Payment proposal</PageTitle>

<RadzenText TextStyle="TextStyle.H4" Class="rz-mb-4">Payment proposal</RadzenText>

<RadzenCard Class="rz-mb-3">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.End" Gap="1rem">
        <RadzenFormField Text="Pay invoices due on or before">
            <RadzenDatePicker @bind-Value="_horizon"
                              DateFormat="d MMM yyyy"
                              Change="@(_ => LoadAsync())" />
        </RadzenFormField>

        <RadzenFormField Text="Payment date">
            <RadzenDatePicker @bind-Value="_paymentDate" DateFormat="d MMM yyyy" />
        </RadzenFormField>

        <RadzenFormField Text="Method">
            <RadzenDropDown @bind-Value="_method" Data="@_methods" />
        </RadzenFormField>

        <RadzenButton Text="Refresh" Icon="refresh"
                      ButtonStyle="ButtonStyle.Light"
                      Click="@LoadAsync" />
    </RadzenStack>
</RadzenCard>

<RadzenDataGrid TItem="PayableInvoiceDto"
                Data="@_payables"
                @bind-Value="@_selected"
                SelectionMode="DataGridSelectionMode.Multiple"
                AllowPaging="true" PageSize="25"
                AllowSorting="true"
                AllowGrouping="true"
                Group="@OnGroup"
                Render="@OnRender"
                EmptyText="No invoices are due within that horizon.">
    <Columns>
        <RadzenDataGridColumn TItem="PayableInvoiceDto" Width="50px"
                              Sortable="false" Filterable="false"
                              Frozen="true">
            <HeaderTemplate>
                <RadzenCheckBox TriState="false" TValue="bool"
                                Value="@(_selected?.Any() == true)"
                                Change="@(v => ToggleAll(v))" />
            </HeaderTemplate>
            <Template Context="invoice">
                <RadzenCheckBox TriState="false" TValue="bool"
                                Value="@(_selected?.Contains(invoice) == true)"
                                Change="@(v => Toggle(invoice, v))" />
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="PayableInvoiceDto" Property="VendorName"
                              Title="Vendor" />
        <RadzenDataGridColumn TItem="PayableInvoiceDto" Property="InternalNumber"
                              Title="Invoice" Width="170px" />
        <RadzenDataGridColumn TItem="PayableInvoiceDto" Property="DueDate"
                              Title="Due" Width="130px"
                              FormatString="{0:d MMM yyyy}" />
        <RadzenDataGridColumn TItem="PayableInvoiceDto" Property="DaysUntilDue"
                              Title="Days" Width="90px"
                              TextAlign="TextAlign.Right">
            <Template Context="i">
                <RadzenBadge IsPill="true"
                             BadgeStyle="@(i.DaysUntilDue < 0
                                           ? BadgeStyle.Danger : BadgeStyle.Light)"
                             Text="@i.DaysUntilDue.ToString()" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="PayableInvoiceDto" Property="AmountOutstanding"
                              Title="Outstanding" Width="170px"
                              TextAlign="TextAlign.Right">
            <Template Context="i">@FormatMoney(i.AmountOutstanding, i.Currency)</Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<RadzenStack Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center"
             Class="rz-mt-3">
    <RadzenText TextStyle="TextStyle.Subtitle1" Class="rz-mb-0">
        @(_selected?.Count() ?? 0) invoices selected ·
        <strong>@FormatMoney(SelectedTotal, "NGN")</strong>
    </RadzenText>

    <RadzenButton Text="Create payment run"
                  Icon="account_balance"
                  ButtonStyle="ButtonStyle.Primary"
                  Disabled="@(_selected?.Any() != true)"
                  IsBusy="@_isSaving"
                  Click="@CreateRunAsync" />
</RadzenStack>

@code {
    private IList<PayableInvoiceDto> _payables = [];
    private IList<PayableInvoiceDto>? _selected;
    private DateTime? _horizon;
    private DateTime? _paymentDate;
    private PaymentMethodDto _method = PaymentMethodDto.BankTransfer;
    private readonly PaymentMethodDto[] _methods = Enum.GetValues<PaymentMethodDto>();
    private bool _isSaving;

    private decimal SelectedTotal => _selected?.Sum(i => i.AmountOutstanding) ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        _horizon = DateTime.Today.AddDays(7);
        _paymentDate = DateTime.Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_horizon is not { } horizon)
        {
            return;
        }

        _payables = (await PaymentApi.GetPayablesAsync(DateOnly.FromDateTime(horizon)))
            .ToList();

        // Reloaded rows are new instances, so earlier selections no longer apply.
        _selected = null;
    }

    private void OnRender(DataGridRenderEventArgs<PayableInvoiceDto> args)
    {
        if (args.FirstRender)
        {
            args.Grid.Groups.Add(new GroupDescriptor
            {
                Property = nameof(PayableInvoiceDto.VendorName),
                Title = "Vendor"
            });
            StateHasChanged();
        }
    }

    // Grouping is presentation only: the server combines the selected
    // invoices into one payment per vendor and currency however the grid
    // is grouped.
    private void OnGroup(DataGridColumnGroupEventArgs<PayableInvoiceDto> args)
    {
    }

    private void ToggleAll(bool selected) =>
        _selected = selected ? _payables.ToList() : null;

    // The click on a row checkbox also reaches the row, and the grid's own
    // multiple selection toggles the row there. Toggling here as well would
    // undo it, so the checkbox only reflects the selection.
    private static void Toggle(PayableInvoiceDto invoice, bool selected)
    {
    }

    private async Task CreateRunAsync()
    {
        if (_selected is not { Count: > 0 } selected || _paymentDate is not { } paymentDate)
        {
            return;
        }

        _isSaving = true;

        try
        {
            var result = await PaymentApi.CreatePaymentRunAsync(new CreatePaymentRunRequest
            {
                PaymentDate = DateOnly.FromDateTime(paymentDate),
                Method = _method,
                InvoiceIds = selected.Select(i => i.InvoiceId).ToList()
            });

            Notifications.Notify(new NotificationMessage
            {
                Severity = result.Succeeded
                    ? NotificationSeverity.Success
                    : NotificationSeverity.Error,
                Summary = result.Succeeded ? "Payment run created" : "Could not create payment run",
                Detail = result.Succeeded
                    ? $"{result.Value?.Count ?? 0} draft payment(s) created."
                    : result.ErrorMessage,
                Duration = result.Succeeded ? 4000 : 8000
            });

            if (result.Succeeded)
            {
                await LoadAsync();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string FormatMoney(decimal amount, string currency) =>
        currency == "NGN" ? $"₦{amount:N2}" : $"{currency} {amount:N2}";
}
