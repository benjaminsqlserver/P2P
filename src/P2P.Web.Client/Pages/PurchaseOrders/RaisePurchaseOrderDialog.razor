@inject IPurchaseOrderApi PurchaseOrderApi
@inject IVendorApi VendorApi
@inject DialogService DialogService

<RadzenTemplateForm TItem="PurchaseOrderFormModel"
                    Data="@_model"
                    Submit="@OnSubmitAsync">

    <RadzenStack Gap="1rem">

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="8">
                <RadzenFormField Text="Vendor" Style="width: 100%;">
                    <ChildContent>
                        <RadzenDropDownDataGrid TValue="Guid?"
                                                Name="VendorId"
                                                @bind-Value="_model.VendorId"
                                                Data="@_vendorOptions"
                                                LoadData="@LoadVendorOptionsAsync"
                                                TextProperty="LegalName"
                                                ValueProperty="Id"
                                                AllowFiltering="true"
                                                FilterDelay="400"
                                                Placeholder="Search active vendors…"
                                                Style="width: 100%;">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="Code"
                                                              Title="Code" Width="110px" />
                                <RadzenDropDownDataGridColumn Property="LegalName"
                                                              Title="Vendor" />
                                <RadzenDropDownDataGridColumn Property="DefaultCurrency"
                                                              Title="Ccy" Width="70px" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </ChildContent>
                    <Helper>
                        <RadzenRequiredValidator Component="VendorId"
                                                 Text="Choose an active vendor." />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="4">
                <RadzenFormField Text="Expected delivery" Style="width: 100%;">
                    <RadzenDatePicker @bind-Value="_model.ExpectedDelivery"
                                      DateFormat="d MMM yyyy"
                                      Min="DateTime.Today" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenFieldset Text="Ship to">
            <RadzenStack Gap="1rem">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="8">
                        <RadzenFormField Text="Address line 1" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="Line1" @bind-Value="_model.Line1" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="Line1" Text="Required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="Line 2" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.Line2" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="City" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="City" @bind-Value="_model.City" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="City" Text="Required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="State / province" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.StateOrProvince" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="Postal code" Style="width: 100%;">
                            <ChildContent>
                                <RadzenTextBox Name="PostalCode"
                                               @bind-Value="_model.PostalCode" />
                            </ChildContent>
                            <Helper>
                                <RadzenRequiredValidator Component="PostalCode"
                                                         Text="Required." />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenFormField Text="Country" Style="width: 100%;">
                            <RadzenTextBox @bind-Value="_model.CountryCode" MaxLength="2" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenStack>
        </RadzenFieldset>

        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="4">
                <RadzenFormField Text="Tax rate (%)" Style="width: 100%;">
                    <RadzenNumeric @bind-Value="_model.TaxRatePercent"
                                   Min="0m" Max="100m" Step="0.5" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="8">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenCheckBox @bind-Value="_model.IssueImmediately"
                                    Name="IssueImmediately" />
                    <RadzenLabel Text="Issue to the vendor immediately"
                                 Component="IssueImmediately" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @if (_serverError is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger"
                         Variant="Variant.Flat"
                         Shade="Shade.Lighter"
                         AllowClose="false">
                @_serverError
            </RadzenAlert>
        }

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Gap="0.5rem">
            <RadzenButton Text="Cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat"
                          ButtonType="ButtonType.Button"
                          Click="@(() => DialogService.Close(false))" />

            <RadzenButton Text="Raise purchase order"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary"
                          IsBusy="@_isSaving"
                          BusyText="Raising…" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid RequisitionId { get; set; }

    private readonly PurchaseOrderFormModel _model = new();
    private IReadOnlyList<VendorLookupDto> _vendorOptions = [];
    private bool _isSaving;
    private string? _serverError;

    protected override async Task OnInitializedAsync() =>
        _vendorOptions = await VendorApi.SearchLookupAsync(null);

    private async Task LoadVendorOptionsAsync(LoadDataArgs args) =>
        _vendorOptions = await VendorApi.SearchLookupAsync(args.Filter);

    private async Task OnSubmitAsync(PurchaseOrderFormModel model)
    {
        _isSaving = true;
        _serverError = null;

        try
        {
            var created = await PurchaseOrderApi.CreateFromRequisitionAsync(
                new CreatePurchaseOrderFromRequisitionRequest
                {
                    RequisitionId = RequisitionId,
                    VendorId = model.VendorId!.Value,
                    ExpectedDeliveryDate = DateOnly.FromDateTime(model.ExpectedDelivery!.Value),
                    TaxRatePercent = model.TaxRatePercent,
                    ShipToAddress = new AddressDto
                    {
                        Line1 = model.Line1!,
                        Line2 = model.Line2,
                        City = model.City!,
                        StateOrProvince = model.StateOrProvince,
                        PostalCode = model.PostalCode!,
                        CountryCode = model.CountryCode
                    }
                });

            if (!created.Succeeded)
            {
                _serverError = created.ErrorMessage ?? "The purchase order could not be raised.";
                return;
            }

            if (model.IssueImmediately)
            {
                var issued = await PurchaseOrderApi.IssueAsync(created.Value);

                if (!issued.Succeeded)
                {
                    // The PO exists as a draft; say so rather than pretend
                    // nothing happened.
                    _serverError = "The purchase order was raised as a draft but could "
                                 + $"not be issued: {issued.ErrorMessage}";
                    return;
                }
            }

            DialogService.Close(true);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class PurchaseOrderFormModel
    {
        public Guid? VendorId { get; set; }
        public DateTime? ExpectedDelivery { get; set; } = DateTime.Today.AddDays(14);
        public string? Line1 { get; set; }
        public string? Line2 { get; set; }
        public string? City { get; set; }
        public string? StateOrProvince { get; set; }
        public string? PostalCode { get; set; }
        public string CountryCode { get; set; } = "NG";

        // Nigeria's standard VAT rate, as used in the book's own examples.
        public decimal TaxRatePercent { get; set; } = 7.5m;
        public bool IssueImmediately { get; set; } = true;
    }
}
