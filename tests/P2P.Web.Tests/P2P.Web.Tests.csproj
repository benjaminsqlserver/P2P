<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="bunit" />
    <!-- Every bunit 1.x is compiled against AngleSharp 1.2.0; the solution-wide
         1.8.6 pin breaks it at runtime (TypeLoadException in Find). The
         advisory below is an mXSS in HTML sanitisation, which does not arise
         here: this test-only project parses our own component markup and is
         never deployed. Remove both lines when moving to bunit 2.x. -->
    <PackageReference Include="AngleSharp" VersionOverride="1.2.0" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\P2P.Web.Client\P2P.Web.Client.csproj" />
    <ProjectReference Include="..\..\src\P2P.Contracts\P2P.Contracts.csproj" />
  </ItemGroup>

</Project>